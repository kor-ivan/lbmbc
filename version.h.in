#ifndef APP_VERSION_H
#define APP_VERSION_H

// Статические части версии
// #define APP_VERSION_MAJOR 0
// #define APP_VERSION_MINOR 0

// Динамически заполняется CMake
#define APP_BUILD_NUMBER @BUILD_NUMBER@
#define APP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define APP_VERSION_MINOR @PROJECT_VERSION_MINOR@

// Форматированная строка версии, которая будет использоваться в QCoreApplication
// Пример: "1.0.42 (Debug, Commit: abcde12)"
#define APP_VERSION_STRING "v.@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@BUILD_NUMBER@ @CMAKE_BUILD_TYPE@ @GIT_COMMIT_HASH@"

#endif // APP_VERSION_H
